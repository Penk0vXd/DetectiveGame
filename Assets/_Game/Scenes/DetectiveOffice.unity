    records:
    - sourceId: doc-case0017-incident-report
      title: "\u041F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u0435\u043D \u0434\u043E\u043A\u043B\u0430\u0434 \u0437\u0430 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430"
