      title: "\u041E\u0442\u0447\u0435\u0442 \u0437\u0430 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u0438 \u043A\u0430\u0440\u0442\u0438 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F"
      recordType: "\u041E\u0442\u0447\u0435\u0442 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F"
      date: 
      body: "\u041E\u0431\u0435\u043A\u0442: Blackwood Technologies, \u041B\u043E\u043D\u0434\u043E\u043D\n\u0418\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043E\u0442 \u0440\u0435\u0433\u0438\u0441\u0442\u044A\u0440\u0430 \u0437\u0430 \u0441\u043B\u0443\u0436\u0435\u0431\u0435\u043D \u0434\u043E\u0441\u0442\u044A\u043F \u0438 \u043A\u0430\u0440\u0442\u0438:\n\n- 21:40 \u2014 \u041A\u0430\u0440\u0442\u0430\u0442\u0430 \u043D\u0430 Michael Reed \u0435 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u043E.\n- 22:15 \u2014 Daniel Brooks \u0435 \u043E\u0441\u044A\u0449\u0435\u0441\u0442\u0432\u0438\u043B \u0434\u043E\u0441\u0442\u044A\u043F \u0434\u043E \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0430 \u0437\u0430 \u0441\u0438\u0433\u0443\u0440\u043D\u043E\u0441\u0442.\n- 23:20 \u2014 Emily Carter \u0435 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u043B\u0430 \u043A\u0430\u0440\u0442\u0430\u0442\u0430 \u0441\u0438 \u043F\u0440\u0438 \u043D\u0430\u043F\u0443\u0441\u043A\u0430\u043D\u0435 \u043D\u0430 \u0441\u0433\u0440\u0430\u0434\u0430\u0442\u0430.\n- \u0422\u0440\u0438 \u0434\u043D\u0438 \u043F\u0440\u0435\u0434\u0438 \u043A\u0440\u0430\u0436\u0431\u0430\u0442\u0430 Sarah Mitchell \u0435 \u0438\u0437\u0434\u0430\u043B\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430 \u043A\u0430\u0440\u0442\u0430 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F. \u0412\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u0442\u0430 \u043A\u0430\u0440\u0442\u0430 \u043D\u0435 \u0435 \u0431\u0438\u043B\u0430 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u043E \u0432\u044A\u0440\u043D\u0430\u0442\u0430."
    - sourceId: doc-orion-comm-daniel-unknown
      title: "\u0421\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u2014 Daniel Brooks / \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D"
      recordType: "\u041F\u0440\u0435\u043F\u0438\u0441 \u043D\u0430 \u043A\u043E\u043C\u0443\u043D\u0438\u043A\u0430\u0446\u0438\u044F"
      date: 
      body: "\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u0446\u0438: Daniel Brooks \u0438 \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\n\n23:05 \u2014 Daniel Brooks:\n\u201E\u0412\u0441\u0438\u0447\u043A\u043E \u0435 \u0433\u043E\u0442\u043E\u0432\u043E. \u0421\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0430 \u043D\u044F\u043C\u0430 \u0434\u0430 \u0437\u0430\u0441\u0435\u0447\u0435 \u043D\u0438\u0449\u043E.\u201C\n\n23:07 \u2014 \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A:\n\u201E\u041F\u043E\u0433\u0440\u0438\u0436\u0438 \u0441\u0435 \u043D\u0438\u043A\u043E\u0439 \u0434\u0430 \u043D\u0435 \u0442\u0435 \u0432\u0438\u0434\u0438.\u201C"
    - sourceId: doc-orion-comm-emily-michael
      title: "\u0421\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u2014 Emily Carter / Michael Reed"
      recordType: "\u041F\u0440\u0435\u043F\u0438\u0441 \u043D\u0430 \u043A\u043E\u043C\u0443\u043D\u0438\u043A\u0430\u0446\u0438\u044F"
      date: 
      body: "\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u0446\u0438: Emily Carter \u0438 Michael Reed\n\n21:15 \u2014 Emily Carter:\n\u201E\u0417\u043D\u0430\u043C \u043A\u0430\u043A\u0432\u043E \u0441\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B \u0441 \u0431\u044E\u0434\u0436\u0435\u0442\u0430 \u0437\u0430 \u0438\u0437\u0441\u043B\u0435\u0434\u0432\u0430\u043D\u0438\u044F.\u201C\n\n21:17 \u2014 Michael Reed:\n\u201E\u0422\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0441\u0438 \u0434\u044A\u0440\u0436\u0438\u0448 \u0443\u0441\u0442\u0430\u0442\u0430 \u0437\u0430\u0442\u0432\u043E\u0440\u0435\u043D\u0430.\u201C"
    - sourceId: doc-orion-comm-sarah-unknown
      title: "\u0421\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u2014 Sarah Mitchell / \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D"
      recordType: "\u041F\u0440\u0435\u043F\u0438\u0441 \u043D\u0430 \u043A\u043E\u043C\u0443\u043D\u0438\u043A\u0430\u0446\u0438\u044F"
      date: 
      body: "\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u0446\u0438: Sarah Mitchell \u0438 \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\n\n22:50 \u2014 Sarah Mitchell:\n\u201E\u0414\u0430\u0434\u043E\u0445 \u0442\u0438 \u0442\u043E\u0432\u0430, \u043A\u043E\u0435\u0442\u043E \u043F\u043E\u0438\u0441\u043A\u0430. \u0422\u043E\u0432\u0430 \u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u044F\u0442 \u043F\u044A\u0442.\u201C"
    - sourceId: doc-orion-daniel-deleted-history
      title: "\u0418\u0437\u0442\u0440\u0438\u0442\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u2014 Daniel Brooks"
      recordType: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u0437\u0430\u043F\u0438\u0441"
      date: 
      body: "\u041E\u0431\u0435\u043A\u0442: \u041A\u043E\u043C\u043F\u044E\u0442\u044A\u0440 \u043D\u0430 Daniel Brooks\n\u0412\u0438\u0434 \u0437\u0430\u043F\u0438\u0441: \u0412\u044A\u0437\u0441\u0442\u0430\u043D\u043E\u0432\u0435\u043D \u0438\u0437\u0442\u0440\u0438\u0442 \u0437\u0430\u043F\u0438\u0441 \u043E\u0442 \u0438\u0441\u0442\u043E\u0440\u0438\u044F\u0442\u0430 \u043D\u0430 \u0442\u044A\u0440\u0441\u0435\u043D\u0438\u044F\u0442\u0430\n\n\u0412\u044A\u0437\u0441\u0442\u0430\u043D\u043E\u0432\u0435\u043D\u0430 \u0437\u0430\u044F\u0432\u043A\u0430:\n\u201E\u041A\u0430\u043A \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0434\u0430 \u0441\u0435 \u0434\u0435\u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0430\u0442 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0438\u0442\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044F \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F, \u0431\u0435\u0437 \u0434\u0430 \u0441\u0435 \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u0430 \u0430\u043B\u0430\u0440\u043C\u0430.\u201C"
    - sourceId: doc-orion-michael-deleted-email
      title: "\u0418\u0437\u0442\u0440\u0438\u0442 \u0438\u043C\u0435\u0439\u043B \u2014 Michael Reed"
      recordType: "\u0412\u044A\u0437\u0441\u0442\u0430\u043D\u043E\u0432\u0435\u043D\u0430 \u043A\u043E\u0440\u0435\u0441\u043F\u043E\u043D\u0434\u0435\u043D\u0446\u0438\u044F"
      date: 
      body: "\u041E\u0442: Michael Reed\n\u0414\u043E: \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\n\u0422\u0435\u043C\u0430: Project Orion \u2014 \u041E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u043D\u0430 \u043E\u0444\u0435\u0440\u0442\u0430\n\u0412\u0440\u0435\u043C\u0435 \u043D\u0430 \u0438\u0437\u043F\u0440\u0430\u0449\u0430\u043D\u0435: \u0434\u0432\u0430 \u0434\u043D\u0438 \u043F\u0440\u0435\u0434\u0438 \u043A\u0440\u0430\u0436\u0431\u0430\u0442\u0430\n\n\u0421\u044A\u0434\u044A\u0440\u0436\u0430\u043D\u0438\u0435 \u043D\u0430 \u0432\u044A\u0437\u0441\u0442\u0430\u043D\u043E\u0432\u0435\u043D\u0438\u044F \u0438\u0437\u0442\u0440\u0438\u0442 \u0438\u043C\u0435\u0439\u043B:\n\u201E\u041F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u044A\u0442 \u0441\u0442\u0440\u0443\u0432\u0430 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u043D\u043E \u043F\u043E\u0432\u0435\u0447\u0435, \u043E\u0442\u043A\u043E\u043B\u043A\u043E\u0442\u043E \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\u0442\u0430 \u0435 \u0433\u043E\u0442\u043E\u0432\u0430 \u0434\u0430 \u043F\u043B\u0430\u0442\u0438 \u0437\u0430 \u043D\u0435\u0433\u043E. \u0423\u0440\u0435\u0434\u0438\u043B \u0441\u044A\u043C \u043A\u0443\u043F\u0443\u0432\u0430\u0447, \u043A\u043E\u0439\u0442\u043E \u0435 \u0433\u043E\u0442\u043E\u0432 \u0434\u0430 \u043F\u043B\u0430\u0442\u0438 2 \u043C\u0438\u043B\u0438\u043E\u043D\u0430 \u0435\u0432\u0440\u043E. \u0422\u0440\u044F\u0431\u0432\u0430 \u0441\u0430\u043C\u043E \u0434\u0430 \u0433\u043E \u0438\u0437\u043D\u0435\u0441\u0435\u043C \u043E\u0442 \u0441\u0433\u0440\u0430\u0434\u0430\u0442\u0430.\u201C"
    - sourceId: doc-orion-financial-transfer-orion-solutions
      title: "\u0424\u0438\u043D\u0430\u043D\u0441\u043E\u0432 \u0437\u0430\u043F\u0438\u0441 \u2014 Orion Solutions"
      recordType: "\u0424\u0438\u043D\u0430\u043D\u0441\u043E\u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442"
      date: 
      body: "\u0418\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043E\u0442 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0430\u0442\u0430 \u0431\u0430\u0437\u0430 \u0434\u0430\u043D\u043D\u0438 \u043D\u0430 Blackwood Technologies:\n\n- \u041D\u0430\u0440\u0435\u0434\u0438\u0442\u0435\u043B: Michael Reed\n- \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B: Orion Solutions (\u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430 \u0431\u0430\u043D\u043A\u043E\u0432\u0430 \u0441\u043C\u0435\u0442\u043A\u0430)\n- \u0421\u0443\u043C\u0430: 15 000 \u0435\u0432\u0440\u043E\n- \u0412\u0440\u0435\u043C\u0435 \u043D\u0430 \u043F\u0440\u0435\u0432\u043E\u0434\u0430: \u043F\u0435\u0442 \u0434\u043D\u0438 \u043F\u0440\u0435\u0434\u0438 \u043A\u0440\u0430\u0436\u0431\u0430\u0442\u0430\n- \u0411\u0435\u043B\u0435\u0436\u043A\u0430 \u043F\u043E \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F\u0442\u0430: \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\u0442\u0430 Orion Solutions \u0435 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0430\u043D\u0430 \u0435\u0434\u0432\u0430 \u0434\u0432\u0435 \u0441\u0435\u0434\u043C\u0438\u0446\u0438 \u043F\u043E-\u0440\u0430\u043D\u043E."
    - sourceId: doc-orion-voice-recording-transcript
      title: "\u041F\u0440\u0435\u043F\u0438\u0441 \u043D\u0430 \u0433\u043B\u0430\u0441\u043E\u0432 \u0437\u0430\u043F\u0438\u0441 \u2014 \u0434\u0432\u0430\u043C\u0430 \u043C\u044A\u0436\u0435"
      recordType: "\u041F\u0440\u0435\u043F\u0438\u0441 \u043D\u0430 \u0433\u043B\u0430\u0441\u043E\u0432 \u0437\u0430\u043F\u0438\u0441"
      date: 
      body: "\u041F\u0440\u0435\u043F\u0438\u0441 \u043D\u0430 \u0432\u044A\u0437\u0441\u0442\u0430\u043D\u043E\u0432\u0435\u043D \u0438\u0437\u0442\u0440\u0438\u0442 \u0433\u043B\u0430\u0441\u043E\u0432 \u0437\u0430\u043F\u0438\u0441 (\u043D\u044F\u043C\u0430 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D \u0430\u0443\u0434\u0438\u043E\u0444\u0430\u0439\u043B).\n\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u0446\u0438: \u0434\u0432\u0430 \u043C\u044A\u0436\u043A\u0438 \u0433\u043B\u0430\u0441\u0430 (\u043D\u0438\u0442\u043E \u0435\u0434\u0438\u043D \u043E\u0442 \u0433\u043E\u0432\u043E\u0440\u0435\u0449\u0438\u0442\u0435 \u043D\u0435 \u0435 \u044F\u0441\u043D\u043E \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u0430\u043D).\n\n\u041F\u044A\u0440\u0432\u0438 \u0433\u043B\u0430\u0441:\n\u201E\u041A\u0443\u043F\u0443\u0432\u0430\u0447\u044A\u0442 \u0438\u0441\u043A\u0430 \u043F\u043E\u0442\u0432\u044A\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u0434\u0438 \u043F\u043E\u043B\u0443\u043D\u043E\u0449.\u201C\n\n\u0412\u0442\u043E\u0440\u0438 \u0433\u043B\u0430\u0441:\n\u201E\u041D\u0435 \u0441\u0435 \u043F\u0440\u0438\u0442\u0435\u0441\u043D\u044F\u0432\u0430\u0439. \u0418\u043C\u0430\u043C \u0447\u043E\u0432\u0435\u043A \u0432\u044A\u0442\u0440\u0435.\u201C\n\n\u041F\u044A\u0440\u0432\u0438 \u0433\u043B\u0430\u0441:\n\u201E\u0410 \u043F\u0430\u0440\u0438\u0442\u0435?\u201C\n\n\u0412\u0442\u043E\u0440\u0438 \u0433\u043B\u0430\u0441:\n\u201E\u0421\u043B\u0435\u0434 \u043A\u0430\u0442\u043E \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u044A\u0442 \u0431\u044A\u0434\u0435 \u0434\u043E\u0441\u0442\u0430\u0432\u0435\u043D.\u201C"
    - sourceId: doc-orion-emily-laboratory-notes
      title: "\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0438 \u0431\u0435\u043B\u0435\u0436\u043A\u0438 \u2014 Emily Carter"
      recordType: "\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0438 \u0431\u0435\u043B\u0435\u0436\u043A\u0438"
      date: 
      body: "\u0410\u0432\u0442\u043E\u0440: Emily Carter (\u0418\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B, Project Orion)\n\u0412\u0438\u0434 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442: \u0418\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0441\u043A\u0438 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0438 \u0431\u0435\u043B\u0435\u0436\u043A\u0438\n\n\u0421\u0442\u0430\u0442\u0443\u0441 \u043D\u0430 \u043F\u0440\u043E\u0435\u043A\u0442\u0430:\n- \u0415\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u043D\u0438\u044F\u0442 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F Project Orion \u0435 \u043F\u043E\u0447\u0442\u0438 \u0433\u043E\u0442\u043E\u0432 \u0437\u0430 \u0442\u044A\u0440\u0433\u043E\u0432\u0441\u043A\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E.\n\n\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435:\n\u201E\u0410\u043A\u043E \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u044A\u0442 \u0431\u044A\u0434\u0435 \u0438\u0437\u043D\u0435\u0441\u0435\u043D \u043E\u0442 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0430\u043D\u0430\u0442\u0430 \u0441\u0438 \u0441\u0440\u0435\u0434\u0430, \u0432\u044A\u0442\u0440\u0435\u0448\u043D\u0438\u0442\u0435 \u043C\u0443 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438 \u043C\u043E\u0433\u0430\u0442 \u0434\u0430 \u0441\u0442\u0430\u043D\u0430\u0442 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u043D\u0438.\u201C"
    - sourceId: doc-orion-hotel-photograph-description
      title: "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043D\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F \u2014 \u043F\u0440\u0435\u0434 \u0445\u043E\u0442\u0435\u043B"
      recordType: "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043D\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F"
      date: 
      body: "\u0422\u0435\u043A\u0441\u0442\u043E\u0432\u043E \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043D\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F (\u043D\u044F\u043C\u0430 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u043E \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435).\n\u041C\u044F\u0441\u0442\u043E \u043D\u0430 \u043E\u0442\u043A\u0440\u0438\u0432\u0430\u043D\u0435: \u041A\u0430\u0431\u0438\u043D\u0435\u0442 \u043D\u0430 Michael Reed\n\n\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435:\n- \u041D\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u0442\u0430 \u0441\u0435 \u0432\u0438\u0436\u0434\u0430 Michael Reed \u043D\u0430 \u0441\u0440\u0435\u0449\u0430 \u0441 \u043C\u044A\u0436 \u043F\u0440\u0435\u0434 \u0445\u043E\u0442\u0435\u043B.\n- \u0414\u0440\u0443\u0433\u0438\u044F\u0442 \u043C\u044A\u0436 \u0435 \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u0430\u043D \u043A\u0430\u0442\u043E \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430 \u043D\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\u0442\u0430 Orion Solutions.\n\n\u041D\u0430\u0434\u043F\u0438\u0441 \u043D\u0430 \u0433\u044A\u0440\u0431\u0430 \u043D\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u0442\u0430:\n\u201E\u041E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u043D\u043E \u0441\u043F\u043E\u0440\u0430\u0437\u0443\u043C\u0435\u043D\u0438\u0435. 11 \u043E\u043A\u0442\u043E\u043C\u0432\u0440\u0438.\u201C"
    - sourceId: doc-orion-cctv-clock-discrepancy
      title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u2014 \u0447\u0430\u0441\u043E\u0432\u043D\u0438\u043A \u043D\u0430 CCTV"
      recordType: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u0434\u043E\u043A\u043B\u0430\u0434"
      date: 
      body: "\u041E\u0431\u0435\u043A\u0442: Blackwood Technologies, \u041B\u043E\u043D\u0434\u043E\u043D\n\u041F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430: \u0412\u0438\u0434\u0435\u043E\u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 (CCTV) \u2014 \u0438\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0441\u043A\u0438 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\n\n\u041A\u043E\u043D\u0441\u0442\u0430\u0442\u0430\u0446\u0438\u044F \u043E\u0442 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u0442\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430:\n- \u041F\u0440\u0438 \u043F\u0440\u0435\u0433\u043B\u0435\u0434 \u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0430 \u0437\u0430 \u0432\u0438\u0434\u0435\u043E\u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u0442\u0435\u0445\u043D\u0438\u043A \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0432\u0430, \u0447\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u044F\u0442 \u0447\u0430\u0441\u043E\u0432\u043D\u0438\u043A \u043D\u0430 CCTV \u0438\u0437\u043E\u0441\u0442\u0430\u0432\u0430 \u0441 12 \u043C\u0438\u043D\u0443\u0442\u0438 \u0441\u043F\u0440\u044F\u043C\u043E \u0440\u0435\u0430\u043B\u043D\u043E\u0442\u043E \u0432\u0440\u0435\u043C\u0435.\n- \u0412\u0441\u0438\u0447\u043A\u0438 \u0432\u0440\u0435\u043C\u0435\u0432\u0438 \u043C\u0430\u0440\u043A\u0438, \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u0438 \u043E\u0442 \u043A\u0430\u043C\u0435\u0440\u0430\u0442\u0430 \u043F\u0440\u0435\u0437 \u043D\u043E\u0449\u0442\u0430 \u043D\u0430 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430, \u0441\u0430 \u0441 12 \u043C\u0438\u043D\u0443\u0442\u0438 \u043F\u043E-\u0440\u0430\u043D\u043D\u0438 \u043E\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u043D\u0438\u044F \u0447\u0430\u0441."
    - sourceId: doc-orion-daniel-phone-location
      title: "\u0414\u0430\u043D\u043D\u0438 \u0437\u0430 \u043B\u043E\u043A\u0430\u0446\u0438\u044F \u2014 \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u043D\u0430 Daniel Brooks"
      recordType: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u0437\u0430\u043F\u0438\u0441 (\u043B\u043E\u043A\u0430\u0446\u0438\u044F)"
      date: 
      body: "\u041E\u0431\u0435\u043A\u0442 \u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0430: \u041C\u043E\u0431\u0438\u043B\u0435\u043D \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u043D\u0430 Daniel Brooks\n\u0412\u0438\u0434 \u0437\u0430\u043F\u0438\u0441: \u0418\u0441\u0442\u043E\u0440\u0438\u044F \u043D\u0430 \u043E\u0442\u0447\u0435\u0442\u0435\u043D\u0430\u0442\u0430 \u043B\u043E\u043A\u0430\u0446\u0438\u044F \u0438 \u043C\u0440\u0435\u0436\u043E\u0432\u0430 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442 \u043D\u0430 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u0442\u043E\n\n\u041E\u0442\u0447\u0435\u0442\u0435\u043D\u0438 \u0441\u044A\u0431\u0438\u0442\u0438\u044F:\n- 22:00 \u2014 \u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u0442\u043E \u0435 \u043E\u0442\u0447\u0435\u0442\u0435\u043D\u043E \u0432 \u0440\u0430\u0439\u043E\u043D\u0430 \u043D\u0430 \u0434\u043E\u043C\u0430 \u043C\u0443.\n- 23:30 \u2014 \u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u0442\u043E \u0435 \u043E\u0442\u0447\u0435\u0442\u0435\u043D\u043E \u0432 \u0440\u0430\u0439\u043E\u043D\u0430 \u043D\u0430 \u0434\u043E\u043C\u0430 \u043C\u0443.\n- 23:55 \u2014 \u0422\u0435\u043B\u0435\u0444\u043E\u043D\u044A\u0442 \u0441\u0435 \u0435 \u0440\u0430\u0437\u043A\u0430\u0447\u0438\u043B \u043E\u0442 \u043C\u0440\u0435\u0436\u0430\u0442\u0430.\n- 00:20 \u2014 \u0422\u0435\u043B\u0435\u0444\u043E\u043D\u044A\u0442 \u0441\u0435 \u0435 \u0441\u0432\u044A\u0440\u0437\u0430\u043B \u043E\u0442\u043D\u043E\u0432\u043E \u043A\u044A\u043C \u043C\u0440\u0435\u0436\u0430\u0442\u0430 \u0432 \u0431\u043B\u0438\u0437\u043E\u0441\u0442 \u0434\u043E \u0434\u043E\u043C\u0430 \u043C\u0443."
    - sourceId: doc-orion-emily-parking-message
      title: "\u041F\u0440\u0435\u043F\u0438\u0441 \u043D\u0430 \u0441\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u2014 Emily Carter (23:48)"
      recordType: "\u041F\u0440\u0435\u043F\u0438\u0441 \u043D\u0430 \u043A\u043E\u043C\u0443\u043D\u0438\u043A\u0430\u0446\u0438\u044F"
      date: 
      body: "\u041F\u043E\u0434\u0430\u0442\u0435\u043B: Emily Carter\n\u041E\u0442\u0447\u0435\u0442\u0435\u043D \u0447\u0430\u0441: 23:48\n\u041E\u0442\u0447\u0435\u0442\u0435\u043D\u043E \u043C\u044F\u0441\u0442\u043E \u043D\u0430 \u0438\u0437\u043F\u0440\u0430\u0449\u0430\u043D\u0435: \u041F\u0430\u0440\u043A\u0438\u043D\u0433\u044A\u0442 \u043D\u0430 Blackwood Technologies\n\n\u0422\u0435\u043A\u0441\u0442 \u043D\u0430 \u0441\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u0435\u0442\u043E:\n\u201E\u0417\u0430\u0431\u0440\u0430\u0432\u0438\u0445 \u0441\u0438 \u0431\u0435\u043B\u0435\u0436\u043D\u0438\u043A\u0430. \u0429\u0435 \u0441\u0435 \u0432\u044A\u0440\u043D\u0430 \u0443\u0442\u0440\u0435.\u201C"
    - sourceId: doc-orion-temp-card-registration
      title: "\u0420\u0435\u0433\u0438\u0441\u0442\u044A\u0440 \u2014 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430 \u043A\u0430\u0440\u0442\u0430 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F"
      recordType: "\u0414\u043E\u043F\u044A\u043B\u043D\u0438\u0442\u0435\u043B\u0435\u043D \u0437\u0430\u043F\u0438\u0441 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F"
      date: 
      body: "\u041E\u0431\u0435\u043A\u0442: \u0411\u0430\u0437\u0430 \u0434\u0430\u043D\u043D\u0438 \u0437\u0430 \u0441\u0438\u0433\u0443\u0440\u043D\u043E\u0441\u0442, Blackwood Technologies\n\u0412\u0438\u0434 \u0437\u0430\u043F\u0438\u0441: \u0414\u043E\u043F\u044A\u043B\u043D\u0438\u0442\u0435\u043B\u043D\u0430 \u0441\u043F\u0440\u0430\u0432\u043A\u0430 \u0437\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u0442\u0430 \u043A\u0430\u0440\u0442\u0430 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F, \u0438\u0437\u0434\u0430\u0434\u0435\u043D\u0430 \u043E\u0442 Sarah Mitchell\n\n\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0430\u043D\u0438 \u0434\u0430\u043D\u043D\u0438:\n- \u0418\u0437\u0434\u0430\u0434\u0435\u043D\u0430 \u043E\u0442: Sarah Mitchell\n- \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0430\u043D\u0430 \u043D\u0430 \u0438\u043C\u0435\u0442\u043E \u043D\u0430: Daniel Brooks\n- 23:56 \u2014 \u0412\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u0442\u0430 \u043A\u0430\u0440\u0442\u0430 \u0435 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0430\u043D\u0430 \u0432 \u043D\u043E\u0449\u0442\u0430 \u043D\u0430 \u043A\u0440\u0430\u0436\u0431\u0430\u0442\u0430.\n- 00:05 \u2014 \u0412\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u0442\u0430 \u043A\u0430\u0440\u0442\u0430 \u0435 \u0434\u0435\u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0430\u043D\u0430.\n- \u0421\u043B\u0443\u0436\u0435\u0431\u043D\u0430\u0442\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430 \u043A\u0430\u0440\u0442\u0430 \u043D\u0430 Daniel Brooks \u043D\u0435 \u0435 \u0431\u0438\u043B\u0430 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u043D\u0430 \u043F\u0440\u0435\u0437 \u0441\u044A\u0449\u0430\u0442\u0430 \u043D\u043E\u0449."
