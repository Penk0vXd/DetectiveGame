  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EvidenceBoardUIController
  boardRoot: {fileID: 1172786551}
  boardPanel: {fileID: 1092280503}
  evidenceDetailsPanel: {fileID: 884021946}
