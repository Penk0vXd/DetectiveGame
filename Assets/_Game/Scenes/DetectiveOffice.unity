  evidenceDescriptionText: {fileID: 14796565}
  cardRects:
  - {fileID: 1248299993}
  - {fileID: 1020206202}
  - {fileID: 1617399487}
  cardProvenanceTexts:
  - {fileID: 1619097378}
  - {fileID: 260415840}
  - {fileID: 1575129331}
  evidenceCards:
  - title: "\u0421\u043D\u0438\u043C\u043A\u0430 \u043D\u0430 \u0436\u0435\u0440\u0442\u0432\u0430\u0442\u0430"
    description: "\u0421\u043D\u0438\u043C\u043A\u0430, \u043D\u0430\u043F\u0440\u0430\u0432\u0435\u043D\u0430 \u043D\u0430 \u043C\u0435\u0441\u0442\u043E\u043F\u0440\u0435\u0441\u0442\u044A\u043F\u043B\u0435\u043D\u0438\u0435\u0442\u043E."
    type: "\u0421\u043D\u0438\u043C\u043A\u0430"
    source: "\u041D\u0430\u043B\u0438\u0447\u043D\u0430\u0442\u0430 \u0441\u043D\u0438\u043C\u043A\u0430 \u043E\u0442 \u043C\u0435\u0441\u0442\u043E\u043F\u0440\u0435\u0441\u0442\u044A\u043F\u043B\u0435\u043D\u0438\u0435\u0442\u043E"
  - title: "\u0411\u0435\u043B\u0435\u0436\u043A\u0430 \u043E\u0442 \u043F\u0430\u0440\u043A\u0438\u043D\u0433"
    description: "\u041E\u0442\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u0438\u044F\u0442 \u0447\u0430\u0441 \u0432\u044A\u0440\u0445\u0443 \u0431\u0435\u043B\u0435\u0436\u043A\u0430\u0442\u0430 \u0435 22:41."
    type: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442"
    source: "\u0411\u0435\u043B\u0435\u0436\u043A\u0430\u0442\u0430 \u043E\u0442 \u043F\u0430\u0440\u043A\u0438\u043D\u0433 \u043D\u0430 \u0431\u044E\u0440\u043E\u0442\u043E"
  - title: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u2014 \u0415\u043B\u0435\u043D\u0430 \u041C\u0443\u0440"
    description: "\u0415\u043B\u0435\u043D\u0430 \u041C\u0443\u0440 \u0441\u044A\u043E\u0431\u0449\u0430\u0432\u0430 \u0437\u0430 \u0448\u0443\u043C \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430, \u043D\u043E \u043D\u0435 \u043F\u043E\u0441\u043E\u0447\u0432\u0430 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u043C\u0443."
    type: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435"
    source: "\u0415\u043B\u0435\u043D\u0430 \u041C\u0443\u0440 (\u0437\u0430\u043F\u0438\u0441 \u0432 \u0434\u043E\u0441\u0438\u0435\u0442\u043E)"
