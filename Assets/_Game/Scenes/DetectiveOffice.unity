  m_EditorClassIdentifier: Assembly-CSharp::CaseFilesUIController
  caseFilesWindow: {fileID: 300722950}
  caseListContent: {fileID: 970018422}
  caseEntryPrefab: {fileID: 7283392442854518777, guid: 6fa40709e8344d944ba2a635f65115c3, type: 3}
  caseNumberText: {fileID: 1082798940}
  caseNameText: {fileID: 1131428001}
  statusText: {fileID: 1577062113}
  dateText: {fileID: 764728368}
  locationText: {fileID: 1870738363}
  victimText: {fileID: 1979714369}
  leadDetectiveText: {fileID: 1945659303}
  summaryText: {fileID: 1406234370}
  overviewPanel: {fileID: 1197806330}
  peoplePanel: {fileID: 1011852021}
  recordsPanel: {fileID: 368490341}
  peopleListContent: {fileID: 823038327}
  personEntryPrefab: {fileID: 7056492518155948132, guid: d3e35594c3e524d42be5562fddd117b2, type: 3}
  personNameText: {fileID: 274006893}
  personRoleText: {fileID: 1282454780}
  personDescriptionText: {fileID: 308137268}
  recordsListContent: {fileID: 2092063439}
  recordEntryPrefab: {fileID: 2049255434623573072, guid: eaa9c7abad9bde84a9f2408af47faaf7, type: 3}
  recordTitleText: {fileID: 2097273359}
  recordTypeText: {fileID: 538100136}
  recordDateText: {fileID: 98478645}
  recordBodyText: {fileID: 763177447}
  cases:
  - caseNumber: CASE-ORION-01
    caseName: "Project Orion \u2014 \u041A\u0440\u0430\u0436\u0431\u0430 \u043D\u0430 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F"
    status: "\u041E\u0422\u0412\u041E\u0420\u0415\u041D\u041E"
    dateOpened: "\u2014"
    location: "Blackwood Technologies, \u041B\u043E\u043D\u0434\u043E\u043D"
    victim: "\u041D\u044F\u043C\u0430 (\u043A\u0440\u0430\u0436\u0431\u0430 \u043D\u0430 \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u0435\u043D \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F)"
    leadDetective: "\u2014"
    summary: "\u0415\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u043D\u0438\u044F\u0442 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F Project Orion \u0435 \u0438\u0437\u0447\u0435\u0437\u043D\u0430\u043B \u043E\u0442 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0430 \u0438\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0441\u043A\u0430 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F \u0432 Blackwood Technologies \u0432 \u041B\u043E\u043D\u0434\u043E\u043D. \u041D\u044F\u043C\u0430 \u0441\u043B\u0435\u0434\u0438 \u043E\u0442 \u0432\u0437\u043B\u043E\u043C, \u0430 \u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u043D\u0430\u0442\u0430 \u0430\u043B\u0430\u0440\u043C\u0430 \u043D\u0435 \u0441\u0435 \u0435 \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u0430\u043B\u0430. \u0420\u0430\u0437\u0441\u043B\u0435\u0434\u0432\u0430\u043D\u0435\u0442\u043E \u0435 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435\u043D \u0435\u0442\u0430\u043F."
    people:
    - name: Daniel Brooks
      role: "\u0422\u0435\u0445\u043D\u0438\u043A \u043F\u043E \u0441\u0438\u0433\u0443\u0440\u043D\u043E\u0441\u0442\u0442\u0430 (Security Technician)"
      shortDescription: "\u0412\u044A\u0437\u0440\u0430\u0441\u0442: 35 \u0433. \u041F\u043E\u0434\u0434\u044A\u0440\u0436\u0430 \u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u043D\u0438\u0442\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0438 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0438\u0442\u0435 \u043A\u043B\u044E\u0447\u0430\u043B\u043A\u0438 \u043D\u0430 Blackwood Technologies. \u041F\u043E\u0437\u043D\u0430\u0432\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0430 \u0437\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B \u043D\u0430 \u0434\u043E\u0441\u0442\u044A\u043F\u0430. \u041F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435: \u0442\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u0435 \u0431\u0438\u043B \u0432\u043A\u044A\u0449\u0438 \u043E\u0442 22:00 \u043D\u0430\u0442\u0430\u0442\u044A\u043A."
    - name: Emily Carter
      role: "\u0418\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B (Research Scientist)"
      shortDescription: "\u0412\u044A\u0437\u0440\u0430\u0441\u0442: 29 \u0433. \u0420\u0430\u0431\u043E\u0442\u0438 \u0434\u0438\u0440\u0435\u043A\u0442\u043D\u043E \u043F\u043E Project Orion \u0438 \u0438\u043C\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D \u0434\u043E\u0441\u0442\u044A\u043F \u0434\u043E \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F\u0442\u0430. \u041F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435: \u0442\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u0435 \u043D\u0430\u043F\u0443\u0441\u043D\u0430\u043B\u0430 \u0441\u0433\u0440\u0430\u0434\u0430\u0442\u0430 \u0432 23:20."
    - name: Michael Reed
      role: "\u0420\u044A\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B \u043F\u0440\u043E\u0435\u043A\u0442 (Project Manager)"
      shortDescription: "\u0412\u044A\u0437\u0440\u0430\u0441\u0442: 42 \u0433. \u041E\u0442\u0433\u043E\u0432\u0430\u0440\u044F \u0437\u0430 \u0431\u044E\u0434\u0436\u0435\u0442\u0430 \u0438 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u043D\u0430\u0442\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u044F \u043D\u0430 Project Orion \u0438 \u0438\u043C\u0430 \u0434\u043E\u0441\u0442\u044A\u043F \u0434\u043E \u0432\u0430\u0436\u043D\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0437\u0430 \u043F\u0440\u043E\u0435\u043A\u0442\u0430. \u041F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435: \u0442\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u0435 \u0431\u0438\u043B \u043D\u0430 \u0431\u0438\u0437\u043D\u0435\u0441 \u0441\u0440\u0435\u0449\u0430 \u0434\u043E \u043F\u043E\u043B\u0443\u043D\u043E\u0449."
    - name: Sarah Mitchell
      role: "\u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u0435\u043D \u043C\u0435\u043D\u0438\u0434\u0436\u044A\u0440 (Administrative Manager)"
      shortDescription: "\u0412\u044A\u0437\u0440\u0430\u0441\u0442: 34 \u0433. \u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0432\u0430 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0438 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F \u0438 \u0438\u043C\u0430 \u043F\u0440\u0430\u0432\u043E\u043C\u043E\u0449\u0438\u0435 \u0434\u0430 \u0438\u0437\u0434\u0430\u0432\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438 \u043A\u0430\u0440\u0442\u0438. \u041F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435: \u0442\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u0435 \u0440\u0430\u0431\u043E\u0442\u0438\u043B\u0430 \u043E\u0442 \u0432\u043A\u044A\u0449\u0438 \u0441\u044A\u0449\u0430\u0442\u0430 \u0432\u0435\u0447\u0435\u0440."
    records:
    - sourceId: doc-orion-initial-security-report
      title: "\u041F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u0435\u043D \u0434\u043E\u043A\u043B\u0430\u0434 \u043D\u0430 \u043E\u0445\u0440\u0430\u043D\u0430\u0442\u0430"
      recordType: "\u0414\u043E\u043A\u043B\u0430\u0434 \u043D\u0430 \u043E\u0445\u0440\u0430\u043D\u0430\u0442\u0430"
      date: 
      body: "\u041E\u0431\u0435\u043A\u0442: Blackwood Technologies, \u041B\u043E\u043D\u0434\u043E\u043D\n\u041B\u0438\u043F\u0441\u0432\u0430\u0449 \u043E\u0431\u0435\u043A\u0442: \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u0435\u043D \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F Project Orion\n\n\u0425\u0440\u043E\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u043D\u0430 \u043E\u0445\u0440\u0430\u043D\u0430\u0442\u0430:\n- 23:30 \u2014 \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F\u0442\u0430 \u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u0430 \u0438 \u0432\u0441\u0438\u0447\u043A\u043E \u0438\u0437\u0433\u043B\u0435\u0436\u0434\u0430 \u043D\u043E\u0440\u043C\u0430\u043B\u043D\u043E.\n- 23:45 \u2014 \u041E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u043D\u0430\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043E\u0442\u0447\u0438\u0442\u0430 \u0441\u044A\u0431\u0438\u0442\u0438\u0435 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F.\n- 00:10 \u2014 \u041E\u0445\u0440\u0430\u043D\u0430\u0442\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0432\u0430 \u043B\u0438\u043F\u0441\u0430\u0442\u0430 \u043D\u0430 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0430.\n\n\u041A\u043E\u043D\u0441\u0442\u0430\u0442\u0430\u0446\u0438\u0438:\n- \u0410\u043B\u0430\u0440\u043C\u0430\u0442\u0430 \u043D\u0435 \u0441\u0435 \u0435 \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u0430\u043B\u0430.\n- \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430\u0442\u0430 \u0432\u0440\u0430\u0442\u0430 \u0435 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0430 \u043F\u0440\u0438 \u043F\u0440\u0438\u0441\u0442\u0438\u0433\u0430\u043D\u0435\u0442\u043E \u043D\u0430 \u043E\u0445\u0440\u0430\u043D\u0430\u0442\u0430."
    - sourceId: doc-orion-cctv-observation
      title: "\u0421\u043F\u0440\u0430\u0432\u043A\u0430 \u0437\u0430 CCTV \u0437\u0430\u043F\u0438\u0441 \u2014 \u043A\u043E\u0440\u0438\u0434\u043E\u0440"
      recordType: "\u0422\u0435\u043A\u0441\u0442\u043E\u0432\u0430 \u0441\u043F\u0440\u0430\u0432\u043A\u0430 (CCTV)"
      date: 
      body: "\u0422\u0435\u043A\u0441\u0442\u043E\u0432\u0430 \u0441\u043F\u0440\u0430\u0432\u043A\u0430 \u0437\u0430 \u0432\u0438\u0434\u0435\u043E\u0437\u0430\u043F\u0438\u0441 (\u043D\u044F\u043C\u0430 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D \u0432\u0438\u0434\u0435\u043E\u0444\u0430\u0439\u043B).\n\u041A\u0430\u043C\u0435\u0440\u0430: \u0418\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0441\u043A\u0438 \u043A\u043E\u0440\u0438\u0434\u043E\u0440, Blackwood Technologies\n\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u043E\u0442 CCTV \u0437\u0430\u043F\u0438\u0441\u0430:\n- 23:45 \u2014 \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u0447\u043E\u0432\u0435\u043A \u0441 \u0442\u044A\u043C\u043D\u043E \u044F\u043A\u0435 \u0438 \u043A\u0430\u0447\u0443\u043B\u043A\u0430 \u0432\u043B\u0438\u0437\u0430 \u0432 \u0438\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0441\u043A\u0438\u044F \u043A\u043E\u0440\u0438\u0434\u043E\u0440.\n- \u0427\u043E\u0432\u0435\u043A\u044A\u0442 \u043D\u043E\u0441\u0438 \u043C\u0430\u043B\u043A\u0430 \u0447\u0430\u043D\u0442\u0430.\n- \u041B\u0438\u0446\u0435\u0442\u043E \u043D\u0435 \u0441\u0435 \u0440\u0430\u0437\u043F\u043E\u0437\u043D\u0430\u0432\u0430 \u0437\u0430\u0440\u0430\u0434\u0438 \u043A\u0430\u0447\u0443\u043B\u043A\u0430\u0442\u0430.\n- 23:52 \u2014 \u0421\u044A\u0449\u0438\u044F\u0442 \u0447\u043E\u0432\u0435\u043A \u043D\u0430\u043F\u0443\u0441\u043A\u0430 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430.\n- \u041D\u0435 \u0441\u0435 \u0432\u0438\u0436\u0434\u0430\u0442 \u0434\u0440\u0443\u0433\u0438 \u0445\u043E\u0440\u0430."
    - sourceId: doc-orion-personnel-daniel-brooks
      title: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E \u0434\u043E\u0441\u0438\u0435 \u2014 Daniel Brooks"
      recordType: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E \u0434\u043E\u0441\u0438\u0435 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435"
      date: 
      body: "\u0421\u043B\u0443\u0436\u0438\u0442\u0435\u043B: Daniel Brooks\n\u0412\u044A\u0437\u0440\u0430\u0441\u0442: 35 \u0433\u043E\u0434\u0438\u043D\u0438\n\u0414\u043B\u044A\u0436\u043D\u043E\u0441\u0442: \u0422\u0435\u0445\u043D\u0438\u043A \u043F\u043E \u0441\u0438\u0433\u0443\u0440\u043D\u043E\u0441\u0442\u0442\u0430 (Security Technician)\n\n\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u0438 \u0437\u0430\u0434\u044A\u043B\u0436\u0435\u043D\u0438\u044F \u0438 \u0434\u043E\u0441\u0442\u044A\u043F:\n- \u041F\u043E\u0434\u0434\u044A\u0440\u0436\u0430 \u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u043D\u0438\u0442\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0438 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0438\u0442\u0435 \u043A\u043B\u044E\u0447\u0430\u043B\u043A\u0438 \u0432 Blackwood Technologies.\n- \u041F\u043E\u0437\u043D\u0430\u0432\u0430 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u0442\u043E \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u0430 \u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0430 \u0437\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B \u043D\u0430 \u0434\u043E\u0441\u0442\u044A\u043F\u0430.\n\n\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u0440\u0430\u043D\u043E \u043F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435:\n- \u0422\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u0432 \u043D\u043E\u0449\u0442\u0430 \u043D\u0430 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430 \u0435 \u0431\u0438\u043B \u0432\u043A\u044A\u0449\u0438 \u043E\u0442 22:00 \u043D\u0430\u0442\u0430\u0442\u044A\u043A."
    - sourceId: doc-orion-personnel-emily-carter
      title: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E \u0434\u043E\u0441\u0438\u0435 \u2014 Emily Carter"
      recordType: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E \u0434\u043E\u0441\u0438\u0435 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435"
      date: 
      body: "\u0421\u043B\u0443\u0436\u0438\u0442\u0435\u043B: Emily Carter\n\u0412\u044A\u0437\u0440\u0430\u0441\u0442: 29 \u0433\u043E\u0434\u0438\u043D\u0438\n\u0414\u043B\u044A\u0436\u043D\u043E\u0441\u0442: \u0418\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B (Research Scientist)\n\n\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u0438 \u0437\u0430\u0434\u044A\u043B\u0436\u0435\u043D\u0438\u044F \u0438 \u0434\u043E\u0441\u0442\u044A\u043F:\n- \u0420\u0430\u0431\u043E\u0442\u0438 \u0434\u0438\u0440\u0435\u043A\u0442\u043D\u043E \u043F\u043E \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u043D\u0438\u044F \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F Project Orion.\n- \u0418\u043C\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D \u0434\u043E\u0441\u0442\u044A\u043F \u0434\u043E \u0438\u0437\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0441\u043A\u0430\u0442\u0430 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F.\n\n\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u0440\u0430\u043D\u043E \u043F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435:\n- \u0422\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u0435 \u043D\u0430\u043F\u0443\u0441\u043D\u0430\u043B\u0430 \u0441\u0433\u0440\u0430\u0434\u0430\u0442\u0430 \u0432 23:20."
    - sourceId: doc-orion-personnel-michael-reed
      title: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E \u0434\u043E\u0441\u0438\u0435 \u2014 Michael Reed"
      recordType: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E \u0434\u043E\u0441\u0438\u0435 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435"
      date: 
      body: "\u0421\u043B\u0443\u0436\u0438\u0442\u0435\u043B: Michael Reed\n\u0412\u044A\u0437\u0440\u0430\u0441\u0442: 42 \u0433\u043E\u0434\u0438\u043D\u0438\n\u0414\u043B\u044A\u0436\u043D\u043E\u0441\u0442: \u0420\u044A\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B \u043F\u0440\u043E\u0435\u043A\u0442 (Project Manager)\n\n\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u0438 \u0437\u0430\u0434\u044A\u043B\u0436\u0435\u043D\u0438\u044F \u0438 \u0434\u043E\u0441\u0442\u044A\u043F:\n- \u041E\u0442\u0433\u043E\u0432\u0430\u0440\u044F \u0437\u0430 \u0431\u044E\u0434\u0436\u0435\u0442\u0430 \u0438 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u043D\u0430\u0442\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u044F \u043D\u0430 Project Orion.\n- \u0418\u043C\u0430 \u0434\u043E\u0441\u0442\u044A\u043F \u0434\u043E \u0432\u0430\u0436\u043D\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0437\u0430 \u043F\u0440\u043E\u0435\u043A\u0442\u0430.\n\n\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u0440\u0430\u043D\u043E \u043F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435:\n- \u0422\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u0435 \u0431\u0438\u043B \u043D\u0430 \u0431\u0438\u0437\u043D\u0435\u0441 \u0441\u0440\u0435\u0449\u0430 \u0434\u043E \u043F\u043E\u043B\u0443\u043D\u043E\u0449."
    - sourceId: doc-orion-personnel-sarah-mitchell
      title: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E \u0434\u043E\u0441\u0438\u0435 \u2014 Sarah Mitchell"
      recordType: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E \u0434\u043E\u0441\u0438\u0435 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435"
      date: 
      body: "\u0421\u043B\u0443\u0436\u0438\u0442\u0435\u043B: Sarah Mitchell\n\u0412\u044A\u0437\u0440\u0430\u0441\u0442: 34 \u0433\u043E\u0434\u0438\u043D\u0438\n\u0414\u043B\u044A\u0436\u043D\u043E\u0441\u0442: \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u0435\u043D \u043C\u0435\u043D\u0438\u0434\u0436\u044A\u0440 (Administrative Manager)\n\n\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u0438 \u0437\u0430\u0434\u044A\u043B\u0436\u0435\u043D\u0438\u044F \u0438 \u0434\u043E\u0441\u0442\u044A\u043F:\n- \u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0432\u0430 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0438 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F \u043D\u0430 \u0441\u043B\u0443\u0436\u0438\u0442\u0435\u043B\u0438\u0442\u0435.\n- \u0418\u043C\u0430 \u043F\u0440\u0430\u0432\u043E\u043C\u043E\u0449\u0438\u0435 \u0434\u0430 \u0438\u0437\u0434\u0430\u0432\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0438 \u043A\u0430\u0440\u0442\u0438 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F.\n\n\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u0440\u0430\u043D\u043E \u043F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435:\n- \u0422\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u0435 \u0440\u0430\u0431\u043E\u0442\u0438\u043B\u0430 \u043E\u0442 \u0432\u043A\u044A\u0449\u0438 \u0441\u044A\u0449\u0430\u0442\u0430 \u0432\u0435\u0447\u0435\u0440."
