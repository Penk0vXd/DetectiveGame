  contactNameText: {fileID: 432758821}
  dialogueText: {fileID: 1175857023}
  contactName: "\u041F\u043E\u043B\u0438\u0446\u0430\u0439 \u041C\u0438\u043B\u044A\u0440"
  dialogue: "\u0411\u0435\u043B\u0435\u0436\u043A\u0430\u0442\u0430 \u043E\u0442 \u043F\u0430\u0440\u043A\u0438\u043D\u0433 \u0435 \u043F\u0440\u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0438\u0442\u0435 \u043D\u0430 \u0431\u044E\u0440\u043E\u0442\u043E \u0442\u0438. \u041D\u0430\u043C\u0435\u0440\u0438\u0445\u043C\u0435 \u044F \u0432 \u043A\u0443\u0445\u043D\u044F\u0442\u0430 \u043D\u0430 \u0430\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u0430."
