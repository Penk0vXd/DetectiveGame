    - name: "\u0422\u043E\u043C\u0430\u0441 \u0420\u0438\u0439\u0434"
      role: "\u041B\u0438\u0446\u0435 \u043E\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441"
      shortDescription: "\u041F\u043E\u0437\u043D\u0430\u0442 \u043D\u0430 \u0436\u0435\u0440\u0442\u0432\u0430\u0442\u0430. \u0412 CASE-0017 \u0435 \u0432\u043A\u043B\u044E\u0447\u0435\u043D \u043A\u0430\u0442\u043E \u043B\u0438\u0446\u0435 \u043E\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441."
    - name: "\u041F\u043E\u043B\u0438\u0446\u0430\u0439 \u041C\u0438\u043B\u044A\u0440"
