    recordSummary: "\u0421\u0430\u043C\u043E\u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0442\u0430 \u0438 \u0430\u0434\u0440\u0435\u0441\u044A\u0442 \u0441\u0430 \u043F\u043E\u0442\u0432\u044A\u0440\u0434\u0435\u043D\u0438. \u0418\u043C\u0430 \u0435\u0434\u043D\u043E \u043F\u0440\u0435\u0434\u0438\u0448\u043D\u043E \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u043D\u0430 \u043F\u044A\u0442\u044F. \u0417\u0430\u043F\u0438\u0441\u044A\u0442 \u043D\u0435 \u0441\u044A\u0434\u044A\u0440\u0436\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0437\u0430 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0442\u043E \u0434\u0435\u043B\u043E."
  - fullName: "\u0415\u043B\u0435\u043D\u0430 \u041C\u0443\u0440"
    dateOfBirth: 08/11/1984
    address: "\u0431\u0443\u043B. \u201E\u0420\u0438\u0432\u044A\u0440\u0441\u0430\u0439\u0434\u201C 19"
    occupation: "\u0421\u0447\u0435\u0442\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B"
    recordSummary: "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u044F\u0442 \u0430\u0434\u0440\u0435\u0441 \u0435 \u043F\u043E\u0442\u0432\u044A\u0440\u0434\u0435\u043D. \u041D\u044F\u043C\u0430 \u043F\u043E\u0441\u043E\u0447\u0435\u043D\u0438 \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u043D\u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438."
