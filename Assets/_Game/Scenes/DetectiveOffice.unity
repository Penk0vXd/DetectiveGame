  contactName: "\u041F\u043E\u043B\u0438\u0446\u0430\u0439 \u041C\u0438\u043B\u044A\u0440"
  dialogue: "\u0412 \u043A\u0443\u0445\u043D\u044F\u0442\u0430 \u043D\u0430\u043C\u0435\u0440\u0438\u0445\u043C\u0435 \u0431\u0435\u043B\u0435\u0436\u043A\u0430 \u043E\u0442 \u043F\u0430\u0440\u043A\u0438\u043D\u0433. \u041E\u0442\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u0438\u044F\u0442 \u0447\u0430\u0441 \u0435 22:41."
