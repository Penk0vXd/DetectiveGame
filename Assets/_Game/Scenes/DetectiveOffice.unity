  evidenceDescriptionText: {fileID: 14796565}
  evidenceCards:
  - title: "\u0421\u043D\u0438\u043C\u043A\u0430 \u043D\u0430 \u0436\u0435\u0440\u0442\u0432\u0430\u0442\u0430"
    description: "\u0421\u043D\u0438\u043C\u043A\u0430, \u043D\u0430\u043F\u0440\u0430\u0432\u0435\u043D\u0430 \u043D\u0430 \u043C\u0435\u0441\u0442\u043E\u043F\u0440\u0435\u0441\u0442\u044A\u043F\u043B\u0435\u043D\u0438\u0435\u0442\u043E."
  - title: "\u0411\u0435\u043B\u0435\u0436\u043A\u0430 \u043E\u0442 \u043F\u0430\u0440\u043A\u0438\u043D\u0433"
    description: "\u041E\u0442\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u0438\u044F\u0442 \u0447\u0430\u0441 \u0432\u044A\u0440\u0445\u0443 \u0431\u0435\u043B\u0435\u0436\u043A\u0430\u0442\u0430 \u0435 22:41."
  - title: "\u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0441\u043A\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F"
    description: "\u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044F\u0442 \u0442\u0432\u044A\u0440\u0434\u0438, \u0447\u0435 \u043B\u0438\u0446\u0435\u0442\u043E \u0435 \u0431\u0438\u043B\u043E \u0432\u043A\u044A\u0449\u0438."
