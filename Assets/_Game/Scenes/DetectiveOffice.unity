  emails:
  - sender: "\u041E\u0442\u0434\u0435\u043B \u041A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u0438\u0441\u0442\u0438\u043A\u0430"
    subject: "\u041F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u0435\u043D \u0434\u043E\u043A\u043B\u0430\u0434 \u043E\u0442 \u043E\u0433\u043B\u0435\u0434\u0430"
    date: 14/10/2011 09:32
    body: "\u041F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u043D\u0438\u044F\u0442 \u043E\u0433\u043B\u0435\u0434 \u0435 \u0437\u0430\u0432\u044A\u0440\u0448\u0435\u043D.\n\n\u0414\u043E\u043F\u044A\u043B\u043D\u0438\u0442\u0435\u043B\u043D\u0438\u0442\u0435 \u0440\u0435\u0437\u0443\u043B\u0442\u0430\u0442\u0438 \u0449\u0435 \u0431\u044A\u0434\u0430\u0442 \u0438\u0437\u043F\u0440\u0430\u0442\u0435\u043D\u0438 \u043F\u043E-\u043A\u044A\u0441\u043D\u043E."
  - sender: "\u041F\u043E\u043B\u0438\u0446\u0430\u0439 \u041C\u0438\u043B\u044A\u0440"
    subject: "\u041F\u0440\u0435\u0442\u044A\u0440\u0441\u0432\u0430\u043D\u0435 \u043D\u0430 \u0430\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u0430"
    date: 14/10/2011 10:05
    body: "\u0412 \u043A\u0443\u0445\u043D\u044F\u0442\u0430 \u043D\u0430\u043C\u0435\u0440\u0438\u0445\u043C\u0435 \u0431\u0435\u043B\u0435\u0436\u043A\u0430 \u043E\u0442 \u043F\u0430\u0440\u043A\u0438\u043D\u0433.\n\n\u041E\u0442\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u0438\u044F\u0442 \u0447\u0430\u0441 \u0435 22:41."
