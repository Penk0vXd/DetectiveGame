    leadDetective: "\u041C\u0430\u0439\u043A\u044A\u043B \u041A\u0430\u0440\u0442\u044A\u0440"
    summary: "\u0416\u0435\u0440\u0442\u0432\u0430\u0442\u0430 \u0435 \u043E\u0442\u043A\u0440\u0438\u0442\u0430 \u043C\u044A\u0440\u0442\u0432\u0430 \u0432 \u0430\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u0430 \u0441\u0438. \u041F\u044A\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u043D\u0438\u044F\u0442 \u0434\u043E\u043A\u043B\u0430\u0434 \u043E\u0442\u0431\u0435\u043B\u044F\u0437\u0432\u0430 \u043E\u0442\u0437\u043E\u0432\u0430\u0432\u0430\u043D\u0435 \u043D\u0430 \u0441\u0438\u0433\u043D\u0430\u043B \u0432 23:20. \u0420\u0430\u0437\u0441\u043B\u0435\u0434\u0432\u0430\u043D\u0435\u0442\u043E \u043F\u0440\u043E\u0434\u044A\u043B\u0436\u0430\u0432\u0430."
    people:
    - name: "\u0414\u0430\u043D\u0438\u0435\u043B \u0425\u0430\u0440\u0438\u0441"
      role: "\u0416\u0435\u0440\u0442\u0432\u0430"
      shortDescription: "\u041E\u0431\u0438\u0442\u0430\u0442\u0435\u043B \u043D\u0430 \u0430\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u0430, \u0432 \u043A\u043E\u0439\u0442\u043E \u0435 \u043F\u043E\u0434\u0430\u0434\u0435\u043D \u0441\u0438\u0433\u043D\u0430\u043B\u044A\u0442."
    - name: "\u0415\u043B\u0435\u043D\u0430 \u041C\u0443\u0440"
      role: "\u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B"
